# Cloudflare caching (public/ is copied into build/ by `npm run build`).

# Favicons and the share image keep their names: a day.
/favicon*
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og-image.jpg
  Cache-Control: public, max-age=86400
# The app's own files are content-hashed: cache them for good.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Rendered images: space.json asks for them with ?v=<hash of the file> (tiles: of the pyramid),
# so a re-render changes their address and they can be cached for good.
/spaces/:space/panos/*
  Cache-Control: public, max-age=31536000, immutable
/spaces/:space/details/*
  Cache-Control: public, max-age=31536000, immutable
/spaces/*/plan.webp
  Cache-Control: public, max-age=31536000, immutable

# The tour data: short, so content updates show up quickly.
/spaces/index.json
  Cache-Control: public, max-age=300
/spaces/*/space.json
  Cache-Control: public, max-age=300
